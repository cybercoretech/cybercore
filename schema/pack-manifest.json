{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cybercore Resource Pack Manifest",
  "type": "object",
  "required": [
    "format_version",
    "id",
    "version",
    "title",
    "kind",
    "description",
    "cybercore",
    "categories",
    "tags",
    "license",
    "provenance",
    "platforms",
    "resources",
    "checksums",
    "accessibility",
    "performance"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": ["effects", "images", "fonts", "svgs", "snippets", "components", "themes"]
    },
    "description": { "type": "string", "minLength": 1 },
    "cybercore": {
      "type": "object",
      "required": ["minimum"],
      "properties": {
        "minimum": { "type": "string", "minLength": 1 },
        "maximum": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "license": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "required": ["source", "author", "license", "reviewed"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "reviewed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "platforms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "title",
          "categories",
          "tags",
          "license",
          "fallback",
          "reduced_motion"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
          "title": { "type": "string", "minLength": 1 },
          "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "license": { "type": "string", "minLength": 1 },
          "fallback": { "type": ["string", "null"] },
          "reduced_motion": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "accessibility": {
      "type": "object",
      "required": ["semantic_fallback", "reduced_motion", "keyboard_safe"],
      "properties": {
        "semantic_fallback": { "type": "string", "minLength": 1 },
        "reduced_motion": { "const": true },
        "keyboard_safe": { "const": true }
      },
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "required": ["risk", "max_cpu_percent", "max_gpu_layers", "mobile_fallback"],
      "properties": {
        "risk": { "enum": ["low", "medium", "high"] },
        "max_cpu_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_gpu_layers": { "type": "integer", "minimum": 0 },
        "mobile_fallback": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "preview": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
