[Unit]
Description=Cybercore Update Control Panel (local only)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/raven/Devspace/Cybercore/framework/cybercore
Environment=CYBERCORE_UPDATE_PANEL_BIND=127.0.0.1:8790
ExecStart=/home/raven/.local/bin/cybercore-update-panel
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
